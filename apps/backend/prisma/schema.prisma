generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

model blocks {
  id                             String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  blocker_id                     String?  @db.Uuid
  blocked_id                     String?  @db.Uuid
  created_at                     DateTime @default(now()) @db.Timestamp(6)
  users_blocks_blocked_idTousers users?   @relation("blocks_blocked_idTousers", fields: [blocked_id], references: [id], onUpdate: NoAction)
  users_blocks_blocker_idTousers users?   @relation("blocks_blocker_idTousers", fields: [blocker_id], references: [id], onUpdate: NoAction)
}

model cards {
  id              String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  scryfallId      String   @unique
  oracleId        String?
  name            String   @db.VarChar(255)
  printedName     String?
  lang            String   @db.Char(3)
  releasedAt      DateTime?
  manaCost        String?
  cmc             Float?
  typeLine        String?
  oracleText      String?  @db.Text
  colors          String[]
  colorIdentity   String[]
  setId           String
  setCode         String   @db.VarChar(10)
  setName         String
  rarity          String?
  artist          String?
  multiverseIds   Json?
  imageUris       Json?
  legalities      Json?
  prices          Json?
  rawData         Json
  createdAt       DateTime @default(now())
  user_cards      user_cards[]
  @@index([name])
  @@index([scryfallId])
  @@index([colors])
  @@index([setCode])
}

model conversations {
  id                                  String     @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  user1_id                            String?    @db.Uuid
  user2_id                            String?    @db.Uuid
  users_conversations_user1_idTousers users?     @relation("conversations_user1_idTousers", fields: [user1_id], references: [id], onUpdate: NoAction)
  users_conversations_user2_idTousers users?     @relation("conversations_user2_idTousers", fields: [user2_id], references: [id], onUpdate: NoAction)
  messages                            messages[]
}

model messages {
  id              String         @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  conversation_id String?        @db.Uuid
  sender_id       String?        @db.Uuid
  content         String
  created_at      DateTime       @default(now()) @db.Timestamp(6)
  conversations   conversations? @relation(fields: [conversation_id], references: [id], onDelete: NoAction, onUpdate: NoAction)
  users           users?         @relation(fields: [sender_id], references: [id], onUpdate: NoAction)
}

model reports {
  id                               String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  reporter_id                      String?  @db.Uuid
  reported_id                      String?  @db.Uuid
  reason                           String
  reason_detail                    String?
  status                           String   @default("pending")
  created_at                       DateTime @default(now()) @db.Timestamp(6)
  users_reports_reported_idTousers users?   @relation("reports_reported_idTousers", fields: [reported_id], references: [id], onUpdate: NoAction)
  users_reports_reporter_idTousers users?   @relation("reports_reporter_idTousers", fields: [reporter_id], references: [id], onUpdate: NoAction)
}

model user_cards {
  id        String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  user_id   String   @db.Uuid
  card_id   String   @db.Uuid
  quantity  Int      @default(1)
  condition String?
  for_trade Boolean? @default(false)
  cards     cards    @relation(fields: [card_id], references: [id], onDelete: Cascade, onUpdate: NoAction)
  users     users    @relation(fields: [user_id], references: [id], onDelete: Cascade, onUpdate: NoAction)
}

model users {
  id                                          String          @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  email                                       String          @unique
  last_lat                                    Float?
  last_long                                   Float?
  created_at                                  DateTime        @default(now()) @db.Timestamp(6)
  blocks_blocks_blocked_idTousers             blocks[]        @relation("blocks_blocked_idTousers")
  blocks_blocks_blocker_idTousers             blocks[]        @relation("blocks_blocker_idTousers")
  conversations_conversations_user1_idTousers conversations[] @relation("conversations_user1_idTousers")
  conversations_conversations_user2_idTousers conversations[] @relation("conversations_user2_idTousers")
  messages                                    messages[]
  reports_reports_reported_idTousers          reports[]       @relation("reports_reported_idTousers")
  reports_reports_reporter_idTousers          reports[]       @relation("reports_reporter_idTousers")
  user_cards                                  user_cards[]
}
