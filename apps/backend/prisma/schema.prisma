generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

enum ChatType {
  DIRECT
  GROUP
  TRADE
}

model User {
  id                       String       @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  email                    String       @unique
  username                 String       @unique
  name                     String
  // last_lat                 Float?
  // last_long                Float?
  created_at               DateTime     @default(now()) @db.Timestamp(6)
  updated_at               DateTime     @updatedAt
  email_verified           Boolean      @default(false)
  image                    String?
  user_cards               UserCard[]
  Block_Blocked_idToUser   Block[]      @relation("blocks_blocked_idToUser")
  Block_Blocker_idToUser   Block[]      @relation("blocks_blocker_idToUser")
  Report_reported_idToUser Report[]     @relation("reports_reported_idToUser")
  Report_reporter_idToUser Report[]     @relation("reports_reporter_idToUser")
  chats                    ChatMember[]
  messages                 Message[]
  Decks                    Deck[]
  sessions                 Session[]
  accounts                 Account[]

  @@map("users")
}

model Block {
  id                     String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  blocker_id             String?  @db.Uuid
  blocked_id             String?  @db.Uuid
  created_at             DateTime @default(now()) @db.Timestamp(6)
  Block_blocked_idToUser User?    @relation("blocks_blocked_idToUser", fields: [blocked_id], references: [id], onUpdate: NoAction)
  Block_blocker_idToUser User?    @relation("blocks_blocker_idToUser", fields: [blocker_id], references: [id], onUpdate: NoAction)

  @@map("blocks")
}

model Report {
  id                       String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  reporter_id              String?  @db.Uuid
  reported_id              String?  @db.Uuid
  reason                   String
  reason_detail            String?
  status                   String   @default("pending")
  created_at               DateTime @default(now()) @db.Timestamp(6)
  Report_reported_idToUser User?    @relation("reports_reported_idToUser", fields: [reported_id], references: [id], onUpdate: NoAction)
  Report_reporter_idToUser User?    @relation("reports_reporter_idToUser", fields: [reporter_id], references: [id], onUpdate: NoAction)

  @@map("reports")
}

model Chat {
  id        String       @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  type      ChatType
  name      String?
  directKey String?      @unique
  sellerId  String?      @map("seller_id") @db.Uuid
  cardId    String?      @map("card_id") @db.Uuid
  createdAt DateTime     @default(now()) @map("created_at") @db.Timestamp(6)
  members   ChatMember[]
  messages  Message[]
  Trade     UserCard?    @relation(fields: [sellerId, cardId], references: [user_id, card_id])

  @@map("chats")
}

model ChatMember {
  chatId            String   @map("chat_id") @db.Uuid
  userId            String   @map("user_id") @db.Uuid
  lastReadMessageId String?  @map("last_read_message_id") @db.Uuid
  joinedAt          DateTime @default(now()) @map("joined_at") @db.Timestamp(6)
  Chat              Chat     @relation(fields: [chatId], references: [id], onDelete: Cascade)
  User              User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@id([chatId, userId])
  @@map("chat_members")
}

model Message {
  id        String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  chatId    String   @map("chat_id") @db.Uuid
  senderId  String?  @map("sender_id") @db.Uuid
  body      String
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamp(6)
  Chat      Chat     @relation(fields: [chatId], references: [id], onDelete: Cascade)
  User      User?    @relation(fields: [senderId], references: [id], onDelete: SetNull)

  @@map("messages")
}

model Card {
  id            String     @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  scryfallId    String     @unique
  oracleId      String?
  name          String     @db.VarChar(255)
  printedName   String?
  lang          String     @db.Char(3)
  releasedAt    DateTime?
  manaCost      String?
  cmc           Float?
  typeLine      String?
  oracleText    String?    @db.Text
  colors        String[]
  colorIdentity String[]
  setId         String
  setCode       String     @db.VarChar(10)
  setName       String
  rarity        String?
  artist        String?
  multiverseIds Json?
  imageUris     Json?
  legalities    Json?
  prices        Json?
  finishes      Json?
  power         String?
  toughness     String?
  keywords      String[]
  rawData       Json
  createdAt     DateTime   @default(now())
  UserCard      UserCard[]
  DeckCards     DeckCard[]

  @@index([name])
  @@index([scryfallId])
  @@index([colors])
  @@index([setCode])
  @@map("cards")
}

model UserCard {
  user_id   String  @db.Uuid
  card_id   String  @db.Uuid
  quantity  Int     @default(1)
  condition String
  for_trade Boolean @default(false)
  wishlist  Boolean @default(false)
  Card      Card    @relation(fields: [card_id], references: [id], onDelete: Cascade, onUpdate: NoAction)
  User      User    @relation(fields: [user_id], references: [id], onDelete: Cascade, onUpdate: NoAction)
  chats     Chat[]

  @@id([user_id, card_id])
  @@map("user_cards")
}

model Deck {
  id        String @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  owner_id  String @db.Uuid
  deck_name String

  User      User       @relation(fields: [owner_id], references: [id], onDelete: Cascade, onUpdate: NoAction)
  deckCards DeckCard[]

  @@map("decks")
}

model DeckCard {
  deck_id  String @db.Uuid
  card_id  String @db.Uuid
  quantity Int
  Deck     Deck   @relation(fields: [deck_id], references: [id], onDelete: Cascade)
  Card     Card   @relation(fields: [card_id], references: [id])

  @@id([deck_id, card_id])
  @@map("deck_cards")
}

model Session {
  id        String   @id @default(dbgenerated("pg_catalog.gen_random_uuid()")) @db.Uuid
  userId    String   @db.Uuid
  expiresAt DateTime
  token     String
  ipAddress String?
  userAgent String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([token])
  @@index([userId])
  @@map("session")
}

model Account {
  id                    String    @id @default(dbgenerated("pg_catalog.gen_random_uuid()")) @db.Uuid
  accountId             String
  providerId            String
  userId                String    @db.Uuid
  accessToken           String?
  refreshToken          String?
  idToken               String?
  accessTokenExpiresAt  DateTime?
  refreshTokenExpiresAt DateTime?
  scope                 String?
  password              String?
  createdAt             DateTime  @default(now())
  updatedAt             DateTime  @updatedAt
  user                  User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("account")
}

model Verification {
  id         String   @id @default(dbgenerated("pg_catalog.gen_random_uuid()")) @db.Uuid
  identifier String
  value      String
  expiresAt  DateTime
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@index([identifier])
  @@map("verification")
}
