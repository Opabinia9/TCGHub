generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

enum ChatType {
 DIRECT
 GROUP
}

model User {
  id                       String               @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  email                    String               @unique
  username                 String               @unique
  first_name               String
  last_name                String
  hash                     String
  last_lat                 Float?
  last_long                Float?
  created_at               DateTime             @default(now()) @db.Timestamp(6)
  updated_at               DateTime             @updatedAt
  user_cards               UserCard[]
  Block_Blocked_idToUser   Block[]              @relation("blocks_blocked_idToUser")
  Block_Blocker_idToUser   Block[]              @relation("blocks_blocker_idToUser")
  Report_reported_idToUser Report[]             @relation("reports_reported_idToUser")
  Report_reporter_idToUser Report[]             @relation("reports_reporter_idToUser")
  chats                    ChatMember[]
  messages                 Message[]

  @@map("users")
}

model Block {
  id                     String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  blocker_id             String?  @db.Uuid
  blocked_id             String?  @db.Uuid
  created_at             DateTime @default(now()) @db.Timestamp(6)
  Block_blocked_idToUser User?    @relation("blocks_blocked_idToUser", fields: [blocked_id], references: [id], onUpdate: NoAction)
  Block_blocker_idToUser User?    @relation("blocks_blocker_idToUser", fields: [blocker_id], references: [id], onUpdate: NoAction)

  @@map("blocks")
}

model Report {
  id                       String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  reporter_id              String?  @db.Uuid
  reported_id              String?  @db.Uuid
  reason                   String
  reason_detail            String?
  status                   String   @default("pending")
  created_at               DateTime @default(now()) @db.Timestamp(6)
  Report_reported_idToUser User?    @relation("reports_reported_idToUser", fields: [reported_id], references: [id], onUpdate: NoAction)
  Report_reporter_idToUser User?    @relation("reports_reporter_idToUser", fields: [reporter_id], references: [id], onUpdate: NoAction)

  @@map("reports")
}

model Chat {
  id                  String               @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  type                ChatType
  title               String
  created_at          DateTime             @default(now()) @db.Timestamp(6)
  ChatMembers         ChatMember[]
  messages            Message[]

  @@map("chats")
}

model ChatMember {
  chat_id              String   @db.Uuid
  user_id              String   @db.Uuid
  last_read_message_id String?  @db.Uuid
  joined_at            DateTime @default(now()) @db.Timestamp(6)
  Chat                 Chat     @relation(fields: [chat_id], references: [id], onDelete: Cascade)
  User                 User     @relation(fields: [user_id], references: [id], onDelete: Cascade)

  @@id([chat_id, user_id])
  @@map("chat_members")
}

model Message {
  id              String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  chat_id         String   @db.Uuid
  sender_id       String?  @db.Uuid
  body            String
  created_at      DateTime @default(now()) @db.Timestamp(6)
  Chat            Chat     @relation(fields: [chat_id], references: [id], onDelete: Cascade)
  User            User?    @relation(fields: [sender_id], references: [id], onDelete: SetNull )

  @@map("messages")
}

model UserCard {
  id        String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  user_id   String   @db.Uuid
  card_id   String   @db.Uuid
  for_trade Boolean? @default(false)
  Card      Card     @relation(fields: [card_id], references: [id], onDelete: Cascade, onUpdate: NoAction)
  User      User     @relation(fields: [user_id], references: [id], onDelete: Cascade, onUpdate: NoAction)

  @@map("user_cards")
}

model Card {
  id            String     @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  scryfallId    String     @unique
  oracleId      String?
  name          String     @db.VarChar(255)
  printedName   String?
  lang          String     @db.Char(3)
  releasedAt    DateTime?
  manaCost      String?
  cmc           Float?
  typeLine      String?
  oracleText    String?    @db.Text
  colors        String[]
  colorIdentity String[]
  setId         String
  setCode       String     @db.VarChar(10)
  setName       String
  rarity        String?
  artist        String?
  multiverseIds Json?
  imageUris     Json?
  legalities    Json?
  prices        Json?
  rawData       Json
  createdAt     DateTime   @default(now())
  UserCard      UserCard[]

  @@index([name])
  @@index([scryfallId])
  @@index([colors])
  @@index([setCode])
  @@map("cards")
}
