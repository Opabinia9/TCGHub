{
  "expo": {
    "name": "tcghub",
    "description": "Trade 'n Track",
    "slug": "tcghub",
    "owner": "sleeplessexpo",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "tcghub",
    "userInterfaceStyle": "dark",
    "ios": {
      "icon": "./assets/images/favicon.png",
      "bundleIdentifier": "com.sleeplessexpo.tcghub"
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#E6F4FE",
        "foregroundImage": "./assets/images/android-icon-foreground.png",
        "backgroundImage": "./assets/images/android-icon-background.png",
        "monochromeImage": "./assets/images/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false,
      "package": "com.sleeplessexpo.tcghub"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#111612",
          "image": "./assets/images/TapThatLogo.png",
          "imageWidth": 200
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    },
    "extra": {
      "router": {
        "asyncRoutes": {
          "web": true
        }
      },
      "eas": {
        "projectId": "1bb3a9bb-b26f-4ce4-865c-26dbb2e87621"
      }
    }
  }
}
